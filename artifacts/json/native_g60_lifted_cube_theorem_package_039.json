  "theorem_result": "The native G60 double cover lifts all 240 automorphisms of G30 to 480 explicit G60 automorphisms. Each of the fifteen affine C2^3 cubes has a non-split order-16 preimage isomorphic to D8 x C2. Its two Petersen endpoint twists lift to commuting order-4 elements squaring to the deck involution a. The four directions admitting dihedral reflection lifts form the affine plane {z, c_u, c_v, z c_u c_v}. Thus the Petersen endpoint geometry controls both the twist support and reflection geometry of every lifted cube.",
  "theorem_statements": [
    {
      "evidence": [
        "native_g30_automorphism_lifts_to_g60_032"
      ],
      "statement": "Every automorphism of G30 preserves the native G60 double-cover class and has exactly two lifts differing by the deck involution a.",
      "theorem_id": "T039-1"
    },
    {
      "evidence": [
        "native_g30_automorphism_lifts_to_g60_032"
      ],
      "statement": "The resulting lifted automorphism group contains 480 explicitly constructed permutations of G60.",
      "theorem_id": "T039-2"
    },
    {
      "evidence": [
        "native_g60_lifted_cube_preimages_033"
      ],
      "statement": "The full preimage of each of the fifteen affine C2^3 cubes has order 16 and abstract type D8 x C2.",
      "theorem_id": "T039-3"
    },
    {
      "evidence": [
        "native_g60_lifted_cube_preimages_033"
      ],
      "statement": "Each central extension 1 -> <a> -> E_tilde -> C2^3 -> 1 is non-split.",
      "theorem_id": "T039-4"
    },
    {
      "evidence": [
        "native_g60_lifted_cube_twist_directions_034"
      ],
      "statement": "Each downstairs cube has exactly two twisted directions whose lifts have order 4 and square a.",
      "theorem_id": "T039-5"
    },
    {
      "evidence": [
        "native_g60_twist_center_partner_law_035"
      ],
      "statement": "The ten twisted directions are exactly zc, where c ranges over the ten six-fixed-point Petersen vertex centers and z is the central deck of G30.",
      "theorem_id": "T039-6"
    },
    {
      "evidence": [
        "native_g60_endpoint_twist_commutator_law_036"
      ],
      "statement": "The two endpoint twist lifts commute, each squares to a, and their product is an involution. They generate C4 x C2 rather than the D8 factor.",
      "theorem_id": "T039-7"
    },
    {
      "evidence": [
        "native_g60_cube_dihedral_reflections_037"
      ],
      "statement": "Each lifted cube has four downstairs reflection directions with involutory lifts that invert an endpoint order-4 twist.",
      "theorem_id": "T039-8"
    },
    {
      "evidence": [
        "native_g60_cube_reflection_affine_plane_038"
      ],
      "statement": "For Petersen edge {u,v}, the reflection register is {z, c_u, c_v, z c_u c_v}, an affine plane inside the downstairs C2^3 cube.",
      "theorem_id": "T039-9"
    }
  ],
  "title": "Native G60 lifted-cube extension and reflection geometry"
