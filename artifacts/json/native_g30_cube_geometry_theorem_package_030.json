  "theorem_result": "Inside Aut(G30), the local elementary abelian subgroup E=C2^3 has 15 conjugates. Their order-4 intersection graph is L(Petersen)=G15. Its 10 triangles have canonical common Klein four centers with fixed-point profile 0,0,6. Those centers form the Petersen graph, and each of the 15 cubes is exactly one Petersen edge. Thus Petersen and G15 are reconstructed intrinsically from native G30 automorphism subgroup geometry.",
  "theorem_statements": [
    {
      "evidence": [
        "native_g30_generated_order8_subgroup_015"
      ],
      "statement": "The subgroup generated by the triangle-local Klein four and the V4_mixed vertex stabilizer is elementary abelian of order 8, hence isomorphic to C2^3.",
      "theorem_id": "T030-1"
    },
    {
      "evidence": [
        "native_g30_c2_cube_normalizer_020",
        "native_g30_c2_cube_normalizer_group_021"
      ],
      "statement": "Its normalizer in Aut(G30) has order 16 and is explicitly isomorphic to D8 x C2.",
      "theorem_id": "T030-2"
    },
    {
      "evidence": [
        "native_g30_c2_cube_linear_action_022",
        "native_g30_c2_cube_named_fixed_plane_023",
        "native_g30_c2_cube_involution_register_024"
      ],
      "statement": "The normalizer acts on C2^3 through an order-2 rank-1 transvection over F2. The kernel is the cube subgroup itself.",
      "theorem_id": "T030-3"
    },
    {
      "evidence": [
        "native_g30_c2_cube_conjugacy_census_026"
      ],
      "statement": "The conjugacy orbit of the cube subgroup in Aut(G30) contains exactly 15 cubes.",
      "theorem_id": "T030-4"
    },
    {
      "evidence": [
        "native_g30_fifteen_cube_graph_027"
      ],
      "statement": "Two cubes are adjacent when their subgroup intersection has order 4. This gives a connected quartic graph on 15 vertices, explicitly isomorphic to L(Petersen).",
      "theorem_id": "T030-5"
    },
    {
      "evidence": [
        "native_g30_cube_triangle_centers_028"
      ],
      "statement": "The 10 triangles of the cube-intersection graph are in bijection with 10 common Klein four centers having nonidentity fixed-point profile 0,0,6.",
      "theorem_id": "T030-6"
    },
    {
      "evidence": [
        "native_g30_petersen_from_cube_centers_029"
      ],
      "statement": "The 10 centers form the Petersen graph when two centers are adjacent exactly when their three-cube supports share one cube. Each of the 15 cubes is exactly one Petersen edge.",
      "theorem_id": "T030-7"
    },
    {
      "evidence": [
        "native_g30_c2_cube_conjugacy_census_026",
        "native_g30_fifteen_cube_graph_027",
        "native_g30_cube_triangle_centers_028",
        "native_g30_petersen_from_cube_centers_029"
      ],
      "statement": "Therefore Petersen and G15=L(Petersen) are recovered intrinsically from the conjugacy and intersection geometry of affine C2^3 cube subgroups inside Aut(G30).",
      "theorem_id": "T030-8"
    }
  ],
  "title": "Native affine-cube reconstruction of Petersen and G15 from G30"
